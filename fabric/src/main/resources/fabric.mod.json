  "name": "LitematicaTool",
  "description": "A simple tool designed to work with Litematica for enhanced schematic management.",
  "authors": [
    "FinnDog"
  ],
  "contact": {
    "homepage": "https://github.com/FinnDog/LitematicaTool",
    "sources": "https://github.com/FinnDog/LitematicaTool"
  },
  "license": "CC0-1.0",
  "icon": "assets/litematicatool/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.finndog.fabric.LitematicaToolFabric"
    ],
    "client": [
